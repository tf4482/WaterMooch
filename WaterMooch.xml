<!-- Settings page element: label, hint, and a multi-line text field for one whisper set -->
<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
  <Frame name="WaterMoochTextAreaTemplate" virtual="true">
    <Size x="600" y="140"/>
    <Layers>
      <Layer level="OVERLAY">
        <FontString parentKey="Label" inherits="GameFontNormal" justifyH="LEFT">
          <Anchors>
            <Anchor point="TOPLEFT" x="37" y="-8"/>
            <Anchor point="TOPRIGHT" x="-40" y="-8"/>
          </Anchors>
        </FontString>
        <FontString parentKey="Hint" inherits="GameFontHighlightSmall" justifyH="LEFT">
          <Anchors>
            <Anchor point="TOPLEFT" relativeKey="$parent.Label" relativePoint="BOTTOMLEFT" y="-4"/>
            <Anchor point="TOPRIGHT" relativeKey="$parent.Label" relativePoint="BOTTOMRIGHT" y="-4"/>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
    <Frames>
      <ScrollFrame parentKey="Input" inherits="InputScrollFrameTemplate">
        <KeyValues>
          <KeyValue key="hideCharCount" value="true" type="boolean"/>
        </KeyValues>
        <Size x="500" y="90"/>
        <Anchors>
          <Anchor point="TOPLEFT" relativeKey="$parent.Hint" relativePoint="BOTTOMLEFT" x="8" y="-8"/>
        </Anchors>
      </ScrollFrame>
    </Frames>
  </Frame>
</Ui>
